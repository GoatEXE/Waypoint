# Safe local defaults for Waypoint pod service.
SERVICE_NAME=waypoint-pod-service
HOST=127.0.0.1
# HOST:PORT is the bridge-only TCP listener (POST /bridge/tools). The control API uses a host-only
# named pipe / Unix socket; override with WAYPOINT_CONTROL_DIR or WAYPOINT_CONTROL_SOCKET if needed.
PORT=3080
LOG_LEVEL=info
DATA_DIR=./runtime/pod
DRY_RUN=true

# Optional one-time provider login for CEO and pods. Build service/docker/auth-image and set both
# image variables below to its immutable sha256 image ID before enabling this. Existing CEO auth
# can be moved with `npm run migrate-shared-auth` while no turn or login is active.
WAYPOINT_SHARED_AUTH=false
WAYPOINT_AUTH_VOLUME=waypoint-hermes-shared-auth

# Pod containers use the pinned Hermes image but start idle; keep DRY_RUN=true unless deliberately testing lifecycle.
POD_DOCKER_IMAGE=nousresearch/hermes-agent@sha256:d4da4a40cd7a28aba983775d9fd31d94cbf153eeb0cb9e844d6d0f612b7c24db
POD_LABEL_NAMESPACE=com.waypoint.pod
POD_NAME_PREFIX=waypoint-pod
POD_VOLUME_PREFIX=waypoint-pod-data

# Containerized Hermes CEO runtime. Keep this digest pinned until deliberately upgraded.
HERMES_DOCKER_IMAGE=nousresearch/hermes-agent@sha256:d4da4a40cd7a28aba983775d9fd31d94cbf153eeb0cb9e844d6d0f612b7c24db
HERMES_CEO_CONTAINER=waypoint-hermes-ceo
HERMES_CEO_VOLUME=waypoint-hermes-ceo-home
HERMES_LOGIN_TIMEOUT_SECONDS=600
# CEO conversation subprocess guardrails. Run budget is passed to Hermes; timeout is the outer service cap.
HERMES_CEO_RUN_BUDGET_SECONDS=120
HERMES_CEO_TURN_TIMEOUT_SECONDS=150
HERMES_CEO_MAX_TURNS=50
HERMES_CEO_MAX_MESSAGE_CHARS=4000
HERMES_CEO_MAX_MESSAGES=100
HERMES_CEO_OUTPUT_LIMIT_BYTES=262144
HERMES_PORTAL_PORT=3081
HERMES_PORTAL_IDLE_MINUTES=30
# The CEO starts/reconciles automatically when the Waypoint service starts.
HERMES_AUTO_START=true
# Optional override; by default this is generated once in DATA_DIR/bridge-token.
# WAYPOINT_BRIDGE_TOKEN=
# Docker Desktop reaches the host service through this name while the service stays local-only.
# WAYPOINT_BRIDGE_BASE_URL=http://host.docker.internal:3080/bridge/tools
